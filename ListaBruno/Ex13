//13. Média ponderada

#include <stdio.h>
#include <stdlib.h>

int main(){
   
   double n1, n2, n3;
   
   printf("Insira suas notas: ");
   scanf("%lf %lf %lf", &n1, &n2, &n3);
   
   double media = ((n1 * 1) + (n2*1) + (n3*2)) / 4; 
   
   if(media >= 6.0){
       printf("Aprovado!");
   } else{
       printf("Reprovado!");
   }
   
}
